# Backend environment variables. Copy to .env and fill in; never commit .env.

# Postgres connection string the API uses at runtime (pooled Neon URL works).
DATABASE_URL=
# Direct (non-pooled) Postgres URL, used by Prisma CLI migrations in prisma.config.ts.
DIRECT_URL=
# Google Gemini API key for categorization and insights.
GEMINI_API_KEY=
# Port the API listens on (defaults to 5000).
PORT=
# Shared secret for verifying API tokens, at least 32 characters; must match the frontend's.
API_AUTH_SECRET=
# Optional comma-separated extra origins allowed by CORS, e.g. a preview site.
CORS_ORIGINS=
# Proxies to trust for the visitor's address: leave unset or 0 locally; set to 3 on Render.
# Too low makes all visitors share one rate-limit counter, too high lets visitors fake their address.
TRUST_PROXY_HOPS=
# Separate test database for npm run test:auth only; must not be the DATABASE_URL host.
TEST_DATABASE_URL=
